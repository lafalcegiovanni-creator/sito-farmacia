# Sito Farmacia La Falce Giovanni - regole per hosting Linux Aruba

# 1. Sempre HTTPS e sempre con "www" (come l'indirizzo canonico del sito)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.farmacialafalcegiovanni.it/$1 [R=301,L]
# Se dopo la pubblicazione il sito va in un ciclo di reindirizzamenti, sostituire
# la riga "RewriteCond %{SERVER_PORT} 80 [OR]" con:
# RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]

# 2. Intestazioni di sicurezza
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# 3. Cache: caratteri a lungo, foto un mese, pagine sempre aggiornate
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp

# 4. Niente elenco dei file nelle cartelle
Options -Indexes
